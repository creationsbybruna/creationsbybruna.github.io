---
// SHA-256 hash of the case study password.
// To change the password: run this in a browser console and paste the result here:
//   crypto.subtle.digest('SHA-256', new TextEncoder().encode('yourpassword'))
//     .then(b => console.log(Array.from(new Uint8Array(b)).map(x=>x.toString(16).padStart(2,'0')).join('')))
const PASS_HASH = "50eafa5c8c8122b8506fc081938569ac0c2af001ebf433ac9a8b62b21a8c92ec";
const SESSION_KEY = "bvg_cs_auth";
---

<!-- Inline check: removes gate immediately if already authenticated, no flash -->
<script is:inline define:vars={{ SESSION_KEY }}>
  if (sessionStorage.getItem(SESSION_KEY) === '1') {
    document.documentElement.dataset.csAuth = '1';
  }
</script>

<div id="pw-gate" class="bvg-pw-gate">
  <div class="bvg-pw-card">
    <p class="bvg-pw-eyebrow">Protected</p>
    <h1 class="bvg-pw-heading">This case study is password protected.</h1>
    <p class="bvg-pw-sub">Enter the password to continue.</p>
    <form id="pw-form" class="bvg-pw-form" novalidate>
      <input
        id="pw-input"
        type="password"
        class="bvg-pw-input"
        placeholder="Password"
        autocomplete="current-password"
        autofocus
        required
      />
      <button type="submit" class="bvg-pw-btn">Unlock</button>
    </form>
    <p id="pw-error" class="bvg-pw-error" hidden>Incorrect password. Try again.</p>
  </div>
</div>

<script define:vars={{ PASS_HASH, SESSION_KEY }}>
  async function sha256(str) {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
    return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
  }

  function unlock() {
    const gate = document.getElementById('pw-gate');
    const content = document.getElementById('pw-content');
    if (gate) gate.remove();
    if (content) content.removeAttribute('hidden');
    sessionStorage.setItem(SESSION_KEY, '1');
  }

  if (sessionStorage.getItem(SESSION_KEY) === '1') {
    unlock();
  }

  document.getElementById('pw-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = document.getElementById('pw-input');
    const error = document.getElementById('pw-error');
    const hash = await sha256(input.value);
    if (hash === PASS_HASH) {
      unlock();
    } else {
      error.hidden = false;
      input.value = '';
      input.focus();
    }
  });
</script>

<style>
  .bvg-pw-gate {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  /* Hide gate instantly when already authenticated (set by inline script) */
  :root[data-cs-auth="1"] .bvg-pw-gate {
    display: none;
  }

  .bvg-pw-card {
    width: 100%;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .bvg-pw-eyebrow {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .bvg-pw-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 32px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin: 0;
  }

  .bvg-pw-sub {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .bvg-pw-form {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }

  .bvg-pw-input {
    flex: 1;
    height: 44px;
    padding: 0 14px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    font-size: 13px;
    outline: none;
    transition: border-color 0.15s;
  }

  .bvg-pw-input::placeholder {
    color: var(--color-text-muted);
  }

  .bvg-pw-input:focus {
    border-color: var(--color-accent-primary);
  }

  .bvg-pw-btn {
    height: 44px;
    padding: 0 20px;
    background: var(--color-text-primary);
    color: var(--color-bg);
    border: none;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.15s;
    white-space: nowrap;
  }

  .bvg-pw-btn:hover {
    opacity: 0.75;
  }

  .bvg-pw-error {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-accent-secondary);
    margin: 0;
  }
</style>
