---
const path = Astro.url.pathname;
const isWork = path === '/' || path.startsWith('/work/');
const isAbout = path === '/about' || path === '/about/';
// const isContact = path === '/contact' || path === '/contact/';
---

<header class="bvg-topbar">
  <a class="bvg-wordmark" href="/">Bruna Viza Gomes</a>

  <div class="bvg-topbar-right">
    <nav class="bvg-nav" id="mobile-nav" aria-label="Primary">
      <a class={`bvg-nav-item${isWork ? ' is-active' : ''}`} href="/">Work</a>
      <a class={`bvg-nav-item${isAbout ? ' is-active' : ''}`} href="/about">About</a>
      {/* <a class={`bvg-nav-item${isContact ? ' is-active' : ''}`} href="/contact">Contact</a> */}
    </nav>

    <button class="bvg-theme-toggle" aria-label="Toggle theme">
      <!-- Sun: shown when dark mode is active, click to go light -->
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="5"/>
        <line x1="12" y1="1" x2="12" y2="3"/>
        <line x1="12" y1="21" x2="12" y2="23"/>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
        <line x1="1" y1="12" x2="3" y2="12"/>
        <line x1="21" y1="12" x2="23" y2="12"/>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
      <!-- Moon: shown when light mode is active, click to go dark -->
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>

    <button class="bvg-menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-nav">
      <span class="bvg-hamburger"></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector('.bvg-menu-toggle') as HTMLButtonElement;
  const nav = document.querySelector('.bvg-nav') as HTMLElement;
  const themeToggle = document.querySelector('.bvg-theme-toggle') as HTMLButtonElement;

  // ---- Mobile nav ----
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      nav.classList.toggle('is-open');
    });

    nav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        nav.classList.remove('is-open');
      });
    });
  }

  // ---- Theme toggle ----
  function getUserPref(): string {
    return localStorage.getItem('bvg-theme') ?? 'dark';
  }

  function applyTheme(userPref: string) {
    localStorage.setItem('bvg-theme', userPref);
    document.documentElement.dataset.theme = userPref;
    if (themeToggle) {
      themeToggle.dataset.current = userPref;
      themeToggle.setAttribute('aria-label', userPref === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
    }
  }

  if (themeToggle) {
    // Sync icon to current stored preference on load
    const initialPref = getUserPref();
    themeToggle.dataset.current = initialPref;
    themeToggle.setAttribute('aria-label', initialPref === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');

    themeToggle.addEventListener('click', () => {
      const current = getUserPref();
      applyTheme(current === 'dark' ? 'light' : 'dark');
    });
  }
</script>
