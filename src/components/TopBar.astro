---
const path = Astro.url.pathname;
const isWork = path === '/' || path.startsWith('/work/');
const isAbout = path === '/about' || path === '/about/';
const isContact = path === '/contact' || path === '/contact/';
---

<header class="bvg-topbar">
  <a class="bvg-wordmark" href="/">Bruna Viza Gomes</a>
  <nav class="bvg-nav" aria-label="Primary">
    <a class={`bvg-nav-item${isWork ? ' is-active' : ''}`} href="/">Work</a>
    <a class={`bvg-nav-item${isAbout ? ' is-active' : ''}`} href="/about">About</a>
    <a class={`bvg-nav-item bvg-nav-contact${isContact ? ' is-active' : ''}`} href="/contact">Contact</a>
  </nav>
</header>
