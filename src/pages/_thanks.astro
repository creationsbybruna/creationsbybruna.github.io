---
import Base from '../layouts/Base.astro';
---

<Base
  title="Message received | Bruna Viza Gomes"
  description="Thank you for reaching out."
>
  <main class="bvg-page">
    <div class="bvg-page-header">
      <div class="bvg-eyebrow">Message Sent</div>
      <h1 class="bvg-page-title">Thanks, message received.</h1>
      <p class="bvg-page-lede">
        I reply to everything within two working days. If you don't hear back, nudge me. It just means I missed it.
      </p>
      <a href="/" class="bvg-btn-ghost" style="margin-top: 32px; display: inline-flex;">Back to Work</a>
    </div>
  </main>
</Base>
