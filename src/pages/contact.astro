---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Base
  title="Contact — Bruna Viza Gomes"
  description="Get in touch with Bruna Viza Gomes — senior PM and designer open to roles, product discovery engagements, and consulting."
>
  <main class="bvg-page">
    <div class="bvg-page-header">
      <div class="bvg-eyebrow">Contact</div>
      <h1 class="bvg-page-title">Let's talk.</h1>
      <p class="bvg-page-lede">
        Best for senior PM &amp; design roles, product discovery engagements, and longer-form consulting. I read every message.
      </p>
    </div>

    <ContactForm />
  </main>
</Base>
