---
import Base from '../layouts/Base.astro';
import ImageSlot from '../components/ImageSlot.astro';

const specialties = [
  {
    num: '01',
    title: 'Technical & Design Fluency',
    body: 'Leading end-to-end design efforts and bringing clearly cultivated UX implementations to life.',
  },
  {
    num: '02',
    title: 'Problem-Solving Expertise',
    body: 'Identifying the why to transform challenges into simple, impactful solutions.',
  },
  {
    num: '03',
    title: 'Leadership in Strategic Design',
    body: 'Guiding teams and product vision through user-centered design thinking and clear problem definition.',
  },
  {
    num: '04',
    title: 'Collaborative Innovation',
    body: 'Driving cross-team workshops leading to staff centered aligned processes company-wide.',
  },
];

const experience = [
  {
    company: 'Impact Observatory',
    role: 'Senior Product Manager & Designer',
    range: 'Jan 2021 – Present',
    current: true,
    bullets: [
      'Led the 0 → 1 launch of one of the first geospatial LLM platform prototypes available in the geospatial analysis field, directly contributing to multiple company funding opportunities.',
      'Wrote system prompts, built agentic workflows, developed QA test pairs, and designed the full design system and end-to-end UX/UI for the same product.',
      'Conducted user and market studies to establish target user groups, define a go-to-market plan, and structure B2B contract opportunities as well as a tiered membership model.',
    ],
  },
  {
    company: 'Trilogy Education',
    role: 'Assistant UX/UI Instructor',
    range: 'Aug 2021 – Feb 2022',
    bullets: [
      'Mentored students in the UX field by establishing an environment where students felt comfortable freely participating and receiving constructive feedback.',
      'Provided career-centered guidance to help students translate classroom learning into industry-ready skills, building their confidence to make a positive impact from day one.',
    ],
  },
  {
    company: 'National Geographic Society',
    role: 'UX Designer',
    range: 'Jun 2018 – Jan 2021',
    bullets: [
      'Led the redesign of the resource library search, home pages, and individual asset pages by integrating user research insights, resulting in enhanced user experience and engagement. Recognized with a Webby Award.',
      'Conducted comprehensive user research and developed innovative design solutions for conservation-driven platforms.',
      'Designed global features (site-wide navigation and profile platform), facilitating seamless communication across all National Geographic Society platforms and improving user interaction and information accessibility.',
    ],
  },
];
---

<Base
  title="About | Bruna Viza Gomes"
  description="Senior product manager and designer based on the US East Coast. Previously National Geographic Society; now Impact Observatory."
>
  <main class="bvg-page">

    <!-- Bio -->
    <section aria-label="Bio">
      <div class="bvg-about">
        <div class="bvg-about-portrait" data-animate="fade">
          <img
            src="/images/bruna.webp"
            alt="Portrait of Bruna Gomes"
            class="bvg-about-portrait-img"
          />
        </div>
        <div class="bvg-about-body">
          <div class="bvg-eyebrow" data-animate>About</div>
          <h1 class="bvg-h1-about" data-animate style="animation-delay: 60ms">Oi! I'm Bruna Gomes, senior product manager and designer based on the US East Coast.</h1>
          <p class="bvg-about-tagline" data-animate style="animation-delay: 120ms">Previously National Geographic Society; now Impact Observatory.</p>

          <p class="bvg-body-lg" data-animate style="animation-delay: 180ms">
            I started my journey at American University, where I studied computer science and graphic design. After finding a way to bridge the two studies, I joined <strong>National Geographic Society</strong> and spent 3 years working and refining my skills as a UX designer.
          </p>
          <p class="bvg-body-lg" data-animate style="animation-delay: 240ms">
            I then joined and have continued to work the past 5 years at <strong>Impact Observatory</strong> (IO) as a senior product member. I initially joined IO as a product designer, and have since been expanding my knowledge to also encompass product management. My typical work day ranges from driving company alignment and product direction, leading user research and interface design efforts, and applying my computer science background to the front-end development of our company website.
          </p>
          <p class="bvg-body-lg" data-animate style="animation-delay: 300ms">
            When I'm not working, you'll find me surfing, shaping surfboards, creating new ceramics, or checking out new cafes.
          </p>
        </div>
      </div>
    </section>

    <!-- Specialties -->
    <section class="bvg-section bvg-section--padded" aria-label="Specialties">
      <div class="bvg-section-head" data-animate>
        <div class="bvg-eyebrow">How I Work</div>
        <h2 class="bvg-section-title">What I Specialize In</h2>
      </div>
      <div class="bvg-spec-grid" data-animate-group>
        {specialties.map(s => (
          <div class="bvg-spec-card" data-animate>
            <div class="bvg-spec-num">{s.num}</div>
            <h3 class="bvg-spec-title">{s.title}</h3>
            <p class="bvg-spec-body">{s.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Experience -->
    <section class="bvg-section bvg-section--surface" aria-label="Experience">
      <div class="bvg-section-head" data-animate>
        <div class="bvg-eyebrow">Experience</div>
        <h2 class="bvg-section-title">Where I've Worked</h2>
      </div>
      <ul class="bvg-exp-list" data-animate-group>
        {experience.map(e => (
          <li class={`bvg-exp-row${e.current ? ' is-current' : ''}`} data-animate>
            <div class="bvg-exp-range">
              {e.range}
              {e.current && <span class="bvg-exp-current-badge">Current</span>}
            </div>
            <div>
              <div class="bvg-exp-role">
                <span class="bvg-exp-company">{e.company}</span>
                <span aria-hidden="true">·</span>
                <span class="bvg-exp-title">{e.role}</span>
              </div>
              {e.bullets && e.bullets.length > 0 && (
                <ul class="bvg-exp-bullets">
                  {e.bullets.map(b => <li>{b}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- CTA -->
    {/* <section class="bvg-about-cta" aria-label="Contact CTA" data-animate>
      <h2 class="bvg-cta-title">Working on something interesting?</h2>
      <p class="bvg-cta-body">
        Open to senior PM and design roles, product discovery engagements, and consulting. If the work sounds good, let's talk.
      </p>
      <a href="/contact" class="bvg-btn-primary">
        Let's Connect
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="13,6 19,12 13,18"/>
        </svg>
      </a>
    </section> */}

  </main>
</Base>
